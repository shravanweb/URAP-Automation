<Activity mc:Ignorable="sap sap2010" x:Class="GenerateReport" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_Raw" Type="InArgument(x:String)" />
    <x:Property Name="out_Report" Type="OutArgument(x:String)" />
  </x:Members>
  <Sequence DisplayName="Generate output report">
    <Assign DisplayName="Build report text">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_Report]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">["URAP execution report" + System.Environment.NewLine + in_Raw]</InArgument></Assign.Value>
    </Assign>
  </Sequence>
</Activity>
