<Activity mc:Ignorable="sap sap2010" x:Class="Initialize" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Sequence DisplayName="Initialize">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="startedAt" />
    </Sequence.Variables>
    <Assign DisplayName="Mark start">
      <Assign.To><OutArgument x:TypeArguments="x:String">[startedAt]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[System.DateTime.UtcNow.ToString("o")]</InArgument></Assign.Value>
    </Assign>
  </Sequence>
</Activity>
