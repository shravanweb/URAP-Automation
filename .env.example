NODE_ENV=development
PORT=4000
# Local portable MariaDB (scripts/start-database.ps1). Docker Compose uses port 3306 instead.
DATABASE_URL=mysql://urap:urap_dev_password@127.0.0.1:3307/urap
# Used only by the backend tests. The test run drops and recreates this database.
TEST_DATABASE_URL=mysql://urap:urap_dev_password@127.0.0.1:3307/urap_test
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CREDENTIALS_KEY=replace-with-base64-32-byte-key
CORS_ORIGIN=http://localhost:5173
# Relative paths resolve from backend/, so ../data is the data folder at the project root.
STORAGE_ROOT=../data/storage
ROBOT_ROOT=../data/robot
BCRYPT_ROUNDS=10
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator
WORKER_ID=worker-1
WORKER_POLL_MS=2000
# A CLAIMED or RUNNING job with no heartbeat for this many minutes is failed as WORKER_LOST.
JOB_STALE_MINUTES=30
# An IN_PROGRESS queue item older than this many hours is marked ABANDONED.
QUEUE_ITEM_ABANDON_HOURS=24
# How long a hybrid workflow's Robot Task step waits for the robot result.
ROBOT_TASK_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_TOKEN=
ORCHESTRATOR_RELEASE_KEY=
ORCHESTRATOR_ORGANIZATION_UNIT_ID=
# Contract robot simulator (npm run robot-simulator). Use the token shown when you register a robot.
ROBOT_TOKEN=
API_URL=http://localhost:4000
ROBOT_POLL_MS=2000

# Web automation (Playwright). Run "npx playwright install chromium" in backend once.
BROWSER_HEADLESS=true
# Use an installed browser instead of the downloaded Chromium: chrome or msedge
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=
BROWSER_TIMEOUT_MS=15000
# Comma-separated hosts workflows may open (empty = any http/https host)
BROWSER_ALLOWED_HOSTS=
# Recorder sessions started from the designer open a visible window unless true
RECORDER_HEADLESS=false

# Desktop automation (Windows UI Automation): auto, windows, mock, none
DESKTOP_DRIVER=auto
DESKTOP_POWERSHELL=powershell.exe
DESKTOP_COMMAND_TIMEOUT_MS=60000

# OCR (tesseract.js). Language data is downloaded to OCR_CACHE_PATH on first use;
# set OCR_LANG_PATH to a folder with eng.traineddata for offline machines.
OCR_CACHE_PATH=../data/ocr-cache
OCR_LANG_PATH=

# Robot agent work folder (default ROBOT_ROOT/work)
ROBOT_WORK_DIR=

# Public self sign-up (Try URAP free). New accounts join the default tenant with SIGNUP_ROLE
# (project_manager, automation_developer, operator, or viewer; never administrator) and get a
# starter project named after their organization.
ALLOW_SIGNUP=true
SIGNUP_ROLE=project_manager
SIGNUP_RATE_LIMIT_MAX=10
SIGNUP_RATE_LIMIT_WINDOW_MS=3600000

# Optional default AI provider for agents. Admins can instead add an "AI provider" connection
# to a project (the key is then stored encrypted). Leave empty to configure in the UI.
# AI_PROVIDER=openai            # openai | azure_openai | anthropic | openai_compatible
# AI_API_KEY=
# AI_BASE_URL=                  # e.g. https://api.groq.com/openai/v1 or http://localhost:11434/v1
# AI_MODEL=gpt-4o-mini
# AI_API_VERSION=               # Azure OpenAI only, e.g. 2024-06-01
